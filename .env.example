# ============================================================
# PulseCut AI — Environment Configuration
# ============================================================
# Copy this file to .env.local for local development.
# NEVER commit secrets or real credentials to source control.

# --- DATABASE ---
# PostgreSQL (recommended for production)
DATABASE_URL="postgresql://user:password@host:5432/pulsecut"
# SQLite (local development fallback)
# DATABASE_URL="file:../../data/app.db"

# --- REDIS / JOB QUEUE ---
# Redis URL for BullMQ job queue
REDIS_URL="redis://localhost:6379"
# Upstash Redis (free tier: https://upstash.com — 10,000 commands/day)
# REDIS_URL="rediss://:<password>@<host>.upstash.io:6379"

# --- REMOTE MEDIA WORKER ---
# URL where the media worker HTTP server is running
MEDIA_WORKER_URL="http://localhost:8080"
# In production: set to your deployed worker URL (Railway, Render, Fly.io, VPS)
# MEDIA_WORKER_URL="https://pulsecut-worker.railway.app"

# Secret shared between Next.js and the worker for authenticated requests
WORKER_SECRET="change-this-to-a-random-32-char-secret"

# --- OBJECT STORAGE ---
# Storage driver: 'local' | 's3' | 'r2'
STORAGE_DRIVER="local"
UPLOAD_DIR="./uploads"

# AWS S3 / Cloudflare R2 (R2 free tier: 10 GB storage, free egress)
# See: https://developers.cloudflare.com/r2/
S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
S3_BUCKET="pulsecut-media"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION="auto"
# Public base URL for signed download URLs
S3_PUBLIC_URL=""

# --- AI PROVIDERS ---
# Gemini API key (optional — for enhanced AI hook/caption generation)
# Get free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# Hugging Face token (optional — for Faster-Whisper inference API)
# Get free token at: https://huggingface.co/settings/tokens
HF_API_TOKEN=""

# --- APPLICATION ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- LIMITS ---
MAX_UPLOAD_SIZE_MB=500
MAX_JOB_DURATION_MINUTES=120
MAX_CONCURRENT_JOBS=2
OUTPUT_RETENTION_HOURS=48
SOURCE_RETENTION_HOURS=24

# --- WORKER SERVER ---
PORT=8080
