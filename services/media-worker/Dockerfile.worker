# ============================================================
# PulseCut AI — Media Worker Dockerfile
# Node.js 22 + FFmpeg (full codec support incl. libass)
# ============================================================

FROM node:22-bookworm-slim AS base

# Install FFmpeg with full codec support including libass for subtitles
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    fonts-liberation \
    fonts-dejavu-core \
    fonts-noto \
    python3 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Health check — waits 60s for startup (FFmpeg hardware detection + warm-up)
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:${PORT:-8080}/health || exit 1

WORKDIR /app

# ============================================================
# Stage: install dependencies
# ============================================================
FROM base AS deps

# Copy workspace manifests for dependency installation
COPY package.json package-lock.json* ./
COPY packages/shared/package.json ./packages/shared/
COPY packages/platform-presets/package.json ./packages/platform-presets/
COPY packages/video-config/package.json ./packages/video-config/
COPY services/media-worker/package.json ./services/media-worker/

# Install all workspace dependencies
RUN npm install --omit=dev --workspace=services/media-worker \
    --workspace=packages/shared \
    --workspace=packages/platform-presets \
    --workspace=packages/video-config

# ============================================================
# Stage: build TypeScript
# ============================================================
FROM base AS builder

WORKDIR /app

# Copy full source for compilation
COPY . .

# Install ALL dependencies (including devDeps for tsc)
RUN npm install

# Build shared packages first, then the worker
RUN npm run build --workspace=packages/shared || true
RUN npm run build --workspace=packages/platform-presets || true
RUN npm run build --workspace=packages/video-config || true
RUN npm run build --workspace=services/media-worker

# ============================================================
# Stage: production runtime
# ============================================================
FROM base AS runner

WORKDIR /app

# Copy production node_modules from deps stage
COPY --from=deps /app/node_modules ./node_modules

# Copy compiled output from builder
COPY --from=builder /app/services/media-worker/dist ./services/media-worker/dist
COPY --from=builder /app/packages/shared/dist ./packages/shared/dist
COPY --from=builder /app/packages/platform-presets/dist ./packages/platform-presets/dist
COPY --from=builder /app/packages/video-config/dist ./packages/video-config/dist

# Copy package manifests needed for module resolution
COPY --from=builder /app/services/media-worker/package.json ./services/media-worker/
COPY --from=builder /app/packages/shared/package.json ./packages/shared/
COPY --from=builder /app/packages/platform-presets/package.json ./packages/platform-presets/
COPY --from=builder /app/packages/video-config/package.json ./packages/video-config/
COPY --from=builder /app/package.json ./

# Create uploads directory with correct permissions
RUN mkdir -p /app/uploads && chown -R node:node /app/uploads

# Run as non-root
USER node

# Expose worker port (default 8080, overridable via PORT env var)
EXPOSE 8080

ENV NODE_ENV=production
ENV PORT=8080
ENV UPLOAD_DIR=/app/uploads

# Start the HTTP server
CMD ["node", "services/media-worker/dist/server.js"]
