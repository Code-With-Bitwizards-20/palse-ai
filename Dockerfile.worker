FROM node:22-bookworm-slim AS base

# Install FFmpeg with full codec support including libass for subtitles and curl for health check
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    fonts-liberation \
    fonts-dejavu-core \
    fonts-noto \
    python3 \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package*.json ./
COPY packages/ ./packages/
COPY services/media-worker/ ./services/media-worker/

RUN npm ci
RUN npm run build --workspace=@shorts/platform-presets
RUN npm run build --workspace=@shorts/video-config
RUN npm run build --workspace=@shorts/shared
RUN npm run build --workspace=@shorts/media-worker

ENV NODE_ENV=production
ENV PORT=8080

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:${PORT:-8080}/health || exit 1

CMD ["npm", "run", "worker", "--workspace=@shorts/media-worker"]
