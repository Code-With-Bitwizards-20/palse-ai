FROM node:22-bullseye-slim AS base

# Install FFmpeg with libass and required multimedia libraries
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    fonts-liberation \
    fonts-dejavu-core \
    python3 \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package*.json ./
COPY packages/ ./packages/
COPY services/media-worker/ ./services/media-worker/

RUN npm ci
RUN npm run build --workspace=@shorts/platform-presets
RUN npm run build --workspace=@shorts/video-config
RUN npm run build --workspace=@shorts/shared
RUN npm run build --workspace=@shorts/media-worker

ENV NODE_ENV=production

CMD ["npm", "run", "worker", "--workspace=@shorts/media-worker"]
