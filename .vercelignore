apps/web/.next/
apps/web/out/
dist/
build/
*.tsbuildinfo

# Dependencies
node_modules/
.pnp
.pnp.js

# Git & Docker
.git/
Dockerfile*
docker-compose.yml

# Environment & logs
.env*.local
*.log
